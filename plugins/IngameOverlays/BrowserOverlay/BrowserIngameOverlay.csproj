<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Platforms>x86;AnyCPU</Platforms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SCDeploySelfPdb>false</SCDeploySelfPdb>
    <AssemblyName>BrowserIngameOverlay</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\StreamCompanion.Common\StreamCompanion.Common.csproj" />
    <ProjectReference Include="..\Overlay.Common\Overlay.Common.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <SCPluginDeployDir>build\Release_browserOverlay\</SCPluginDeployDir>
  </PropertyGroup>
  <ItemGroup>
    <SCPluginDeployFile Include="BrowserIngameOverlay.pdb" />
    <SCPluginDeployFile Include="BrowserIngameOverlay.deps.json" />
    <SCPluginDeployDll Include="Overlay.Common.dll" />
    <SCPluginDeployDll Include="Overlay.Common.pdb" />
    <SCPluginDeploySourceDll Include="..\Overlay.Common\Dlls\X32ProcessOverlayHelper.exe" />
  </ItemGroup>
</Project>