<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>osuOverlay</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SCDeploySelfPdb>false</SCDeploySelfPdb>
    <AssemblyName>TextIngameOverlay</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="TextOverlaySettings.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\StreamCompanion.Common\StreamCompanion.Common.csproj" />
    <ProjectReference Include="..\Overlay.Common\Overlay.Common.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <SCPluginDeployDir>build\Release_unsafe\</SCPluginDeployDir>
  </PropertyGroup>
  <ItemGroup>
    <SCPluginDeployFile Include="TextIngameOverlay.pdb" />
    <SCPluginDeployFile Include="TextIngameOverlay.deps.json" />
    <SCPluginDeployDll Include="Overlay.Common.dll" />
    <SCPluginDeployDll Include="Overlay.Common.pdb" />
    <SCPluginDeploySourceDll Include="Dlls\freetype.dll" />
    <SCPluginDeploySourceDll Include="Dlls\textOverlay.dll" />
    <SCPluginDeploySourceDll Include="..\Overlay.Common\Dlls\X32ProcessOverlayHelper.exe" />
  </ItemGroup>
</Project>